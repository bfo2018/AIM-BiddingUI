# Franchise Bidding Platform — frontend build-time configuration
# Copy to `.env` in this directory: cp .env.example .env
#
# Client bundles still expose any values you set here to browsers (network / minified JS).
# Use `.env` so secrets are not committed to git; restrict API keys (e.g. Maps) by HTTP referrer in the provider console.

# Set true when building a production bundle (or add to server .env before `npm run build`).
FBP_PRODUCTION=false

# Maps JavaScript API key (restrict by HTTP referrer in Google Cloud Console).
GOOGLE_MAPS_API_KEY=

# Set true to use local dummy franchise auth (no backend OTP).
USE_DUMMY_FRANCHISE_AUTH=false

# Used when USE_DUMMY_FRANCHISE_AUTH=true
FRANCHISE_DEMO_AIM_ID=AIM1001
FRANCHISE_DEMO_PASSWORD=demo123

FRANCHISE_API_BASE_URL=https://transaction-european-squad-strengthen.trycloudflare.com/api
ADMIN_API_BASE_URL=https://transaction-european-squad-strengthen.trycloudflare.com/api/admin
FRANCHISE_REGISTRATION_API_URL=https://transaction-european-squad-strengthen.trycloudflare.com
BIDDING_SOCKET_URL=https://transaction-european-squad-strengthen.trycloudflare.com

# Razorpay checkout key id (typically publishable test/live key).
RAZORPAY_KEY_ID=
